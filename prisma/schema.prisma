// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO 1: AUTENTICACIÓN Y USUARIOS
// ==========================================

enum UserRole {
  ADMIN
  HUNTER // Candidato (Busca trabajo)
  RECRUITER // Reclutador (Busca candidatos)
  BUSINESS // Empresa (Gestiona procesos)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Opcional, para login con email/pass
  role          UserRole  @default(HUNTER)

  // Manejo de Uso Gratuito
  dailyAnalysesUsed  Int       @default(0)
  dailyAnalysesLimit Int       @default(20)
  dailyAnalysesDate  DateTime?

  // Relaciones de NextAuth
  accounts Account[]
  sessions Session[]

  // Perfil Profesional (Separación de Identidad)
  profile Profile?

  // Nuevas relaciones para Economía y Logros
  balance      Balance?
  coinBuckets  CoinBucket[]
  ledgers      TokenLedger[]
  usageLogs    UsageLog[]
  transactions PaymentTransaction[]
  quests       UserQuest[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  MappingSuggestion MappingSuggestion[]
}

// Modelo que separa los datos profesionales de la identidad privada
model Profile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic Boolean @default(false)

  // Relaciones del Negocio (Movidas desde User)
  cvs          CV[]
  applications JobApplication[]
  positions    Position[]
  stats        ProviderStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tablas estándar para OAuth (Google, LinkedIn, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MÓDULO 2: CORE - CANDIDATOS Y APLICACIONES
// ==========================================

model CV {
  id         String   @id @default(cuid())
  name       String // Nombre del archivo o etiqueta
  text       String   @db.Text // Contenido completo parseado
  uploadDate DateTime @default(now())

  // Campo CRÍTICO: Define cuál es el CV visible para los reclutadores.
  // Solo un CV por perfil debe tener isPrimary = true.
  isPrimary Boolean @default(false)

  // Relación con Profile en lugar de User
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Relación con palabras clave detectadas en este CV
  keywords CVKeyword[]

  // Relación opcional: Aplicaciones hechas específicamente con este CV
  applications JobApplication[]

  @@index([profileId])
}

model JobApplication {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  link           String?
  jobTitle       String // Título del puesto al que se aplica
  jobDescription String   @db.Text // Descripción completa de la oferta
  provider       String? // IA utilizada para el análisis (ej: GPT-4, Gemini)
  status         String   @default("APPLIED") // Estado del proceso (APPLIED, REJECTED, etc.)

  // Relación con Profile en lugar de User
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Relación con una posición deseada guardada por el perfil
  positionId            String?
  position              Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  originalPositionTitle String? // Snapshot histórico del nombre de la posición

  // NUEVO: Enlace al diccionario global de puestos (Capa 3)
  canonicalPositionId String?
  canonicalPosition   CanonicalPosition? @relation(fields: [canonicalPositionId], references: [id], onDelete: SetNull)

  // CV utilizado para esta aplicación
  cvId String?
  cv   CV?     @relation(fields: [cvId], references: [id])

  // Palabras clave detectadas en la descripción del trabajo
  keywords JobApplicationKeyword[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([jobTitle]) // Índice para búsquedas rápidas de ofertas por título
}

model Position {
  id        String   @id @default(cuid())
  title     String // Nombre del puesto deseado (ej: "Frontend Developer")
  createdAt DateTime @default(now())

  // Relación con Profile en lugar de User
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  applications JobApplication[]

  @@unique([profileId, title]) // Un perfil no debería tener duplicada la misma posición deseada
  @@index([title]) // Vital para agrupar estadísticas globales por puesto
}

// ==========================================
// MÓDULO 3: DICCIONARIO DE KEYWORDS (INTELLIGENCE)
// ==========================================

// Diccionario Maestro de Palabras Clave
// Cada palabra única existe una sola vez aquí (ej: ID_1 = "React", ID_2 = "Java").
model Keyword {
  id            String  @id @default(cuid())
  canonicalText String  @unique // Texto oficial/canónico (ej: "react")
  category      String? // Opcional: Clasificación (Tecnología, Soft Skill, Idioma)
  isApproved    Boolean @default(false)

  // Relación 1:N con Alias (Familias Semánticas)
  aliases KeywordAlias[]

  // Relaciones inversas para navegar el grafo
  cvs             CVKeyword[]
  jobApplications JobApplicationKeyword[]

  @@index([canonicalText])
}

// Nuevo modelo para soportar variaciones (ej: "React.js", "ReactJS" -> "react")
model KeywordAlias {
  id        String @id @default(cuid())
  aliasText String @unique // Variación (ej: "reactjs", "react.js", "react")

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([aliasText]) // Índice vital para búsquedas rápidas por texto
}

// Tabla Intermedia: CV <-> Keyword
// Representa: "Este CV contiene esta palabra clave"
model CVKeyword {
  cvId      String
  keywordId String

  cv      CV      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([cvId, keywordId]) // Llave compuesta
  @@index([keywordId]) // OPTIMIZACIÓN: Permite buscar rápidamente "Todos los CVs con Java"
}

// Tabla Intermedia: JobApplication <-> Keyword
// Representa: "Esta oferta de trabajo pide esta palabra clave"
model JobApplicationKeyword {
  jobApplicationId String
  keywordId        String

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  keyword        Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([jobApplicationId, keywordId])
  @@index([keywordId]) // OPTIMIZACIÓN: Permite buscar "Todas las ofertas que piden Java"
}

// ==========================================
// MÓDULO 4: MÉTRICAS
// ==========================================

model ProviderStats {
  id        String @id @default(cuid())
  provider  String // Nombre del proveedor (OpenAI, Anthropic, etc.)
  generated Int    @default(0)
  accepted  Int    @default(0)
  rejected  Int    @default(0)

  // Relación con Profile en lugar de User
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, provider])
}

// ==========================================
// MÓDULO 5: DICCIONARIO GLOBAL DE PUESTOS
// ==========================================

// 1. Capa Superior: Sector o Industria
model Sector {
  id          String  @id @default(cuid())
  name        String  @unique // ej: "Tecnología / IT", "Marketing", "Finanzas"
  description String?
  isActive    Boolean @default(true)

  positions CanonicalPosition[]
}

// 2. Capa Media: Puesto Canónico
model CanonicalPosition {
  id       String  @id @default(cuid())
  name     String  @unique // ej: "Frontend Developer"
  isActive Boolean @default(true)

  // Relación con el Sector
  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  // Relación con las aplicaciones reales
  applications JobApplication[]

  // Relación con los alias
  aliases PositionAlias[]
}

// 3. Capa Inferior: Alias (El mapeo automático)
model PositionAlias {
  id        String @id @default(cuid())
  aliasText String @unique // ej: "React Ninja", "UI Engineer"

  canonicalPositionId String
  canonicalPosition   CanonicalPosition @relation(fields: [canonicalPositionId], references: [id], onDelete: Cascade)
}

// ==========================================
// MÓDULO 6: CROWDSOURCING Y MODERACIÓN
// ==========================================

enum SuggestionType {
  ALIAS_TO_CANONICAL // Proponer que "React Ninja" sea "Frontend Developer"
  CANONICAL_TO_SECTOR // Proponer que "Frontend Developer" pertenezca a "Tecnología / IT"
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model MappingSuggestion {
  id   String         @id @default(cuid())
  type SuggestionType

  // Campos usados si type == ALIAS_TO_CANONICAL
  rawTitle             String?
  suggestedCanonicalId String? // ID si sugiere un canónico existente
  proposedNewCanonical String? // Texto si sugiere crear un canónico nuevo

  // Campos usados si type == CANONICAL_TO_SECTOR
  targetCanonicalId String? // El puesto canónico que se quiere categorizar
  suggestedSectorId String? // ID si sugiere un sector existente
  proposedNewSector String? // Texto si sugiere crear un sector nuevo

  status SuggestionStatus @default(PENDING)

  userId String // Usuario o Recruiter que hace la propuesta
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO 7: ECONOMÍA, TOKENS Y SUSCRIPCIONES
// ==========================================

// 1. Capa de Performance: Caché del saldo actual
model Balance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tokens Totales (Calculable desde Ledger/Buckets)
  coins Int @default(0) // Monedas (vencen)
  gems  Int @default(0) // Diamantes (no vencen)

  // Control de concurrencia (Optimistic Locking)
  version Int @default(0)

  // Estado de suscripción
  subscriptionExpiresAt DateTime?

  updatedAt DateTime @updatedAt

  // Índice compuesto para Optimistic Locking
  @@unique([userId, version])
}

// 2. Capa de Lógica: Lotes de Monedas (Resuelve expiraciones múltiples)
model CoinBucket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalAmount  Int // Cuánto se otorgó originalmente
  remainingAmount Int // Cuánto queda disponible en este lote
  expiresAt       DateTime // Cuándo expiran exactamente

  createdAt DateTime @default(now())

  // Índices para optimizar la búsqueda de buckets próximos a expirar
  @@index([userId, expiresAt])
}

// 3. Capa de Auditoría: El Libro Contable Inmutable (Ledger)
enum TokenType {
  COIN
  GEM
}

enum Direction {
  CREDIT
  DEBIT
}

enum LedgerReason {
  SUBSCRIPTION_GRANT
  USAGE
  QUEST_REWARD
  PURCHASE
  EXPIRATION
  ADMIN_ADJUSTMENT
}

model TokenLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tipo de operación
  tokenType TokenType
  direction Direction

  // Variación en este movimiento
  coinsDelta Int @default(0)
  gemsDelta  Int @default(0)

  reason LedgerReason

  // Trazabilidad e Idempotencia
  referenceType String? // ej: "usage_log", "payment_transaction", "quest"
  referenceId   String?
  bucketId      String? // Opcional: para saber de qué lote salió/entró la moneda

  // Auditoría estricta: Saldo resultante de la transacción
  balanceAfterCoins Int @default(0)
  balanceAfterGems  Int @default(0)

  createdAt DateTime @default(now())

  // Idempotencia fuerte: Evitar procesar dos veces el mismo evento
  // Solo se aplica si referenceType y referenceId no son nulos. Prisma lo permite.
  @@unique([referenceType, referenceId])
  @@index([userId])
  @@index([tokenType])
  @@index([reason])
}

// Enums para acciones específicas del usuario
enum ActionType {
  CREATE_POSTULATION
  IMPROVE_CV
  GENERATE_COVER_LETTER
}

// Historial detallado de consumo en la plataforma
model UsageLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action       ActionType
  providerUsed String?

  // Detalle del consumo mixto
  // Nota: total tokens = coinsConsumed + gemsConsumed
  coinsConsumed Int @default(0)
  gemsConsumed  Int @default(0)

  // Auditoría: Saldo antes y después
  coinsBefore Int?
  coinsAfter  Int?
  gemsBefore  Int?
  gemsAfter   Int?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Historial inmutable de compras (Agnóstico al proveedor)
model PaymentTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Float // Monto en dinero fiat
  currency String @default("ARS")

  provider     String // "mercadopago", "paypal", "stripe"
  providerTxId String        @unique
  status       PaymentStatus @default(PENDING)

  type String // "subscription" o "gems_pack"

  // Qué se otorgó exactamente
  coinsGranted Int @default(0)
  gemsGranted  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// MÓDULO 8: LOGROS (QUESTS)
// ==========================================

// El catálogo de logros disponibles
model Quest {
  id          String  @id @default(cuid())
  title       String // ej: "Primeros pasos"
  description String? // ej: "Crea tu primera postulación"

  rewardGems Int // Premio en diamantes

  // Lógica de validación
  conditionType  ActionType
  conditionValue Int        @default(1) // ej: 5 postulaciones

  isActive Boolean @default(true)

  userProgress UserQuest[]
}

// Progreso individual del usuario
model UserQuest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, questId])
  @@index([userId])
}
