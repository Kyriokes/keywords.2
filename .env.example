# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/keywords_db"

# NextAuth Configuration
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_secreto_super_seguro"
# URL base de la aplicación (local o producción)
AUTH_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="tu_google_client_id"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"

# LinkedIn OAuth Credentials (opcional: el login con LinkedIn está oculto en la UI)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Proveedores de IA: completá solo los que vayas a usar.
# Si no hay ninguno configurado se usa Ollama local (http://127.0.0.1:11434).
GROQ_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTERAI_API_KEY=""
HUGGINGFACE_API_KEY=""
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""

# Opcional: fuerza un proveedor para depurar (groq, gemini, deepseek, openrouter,
# huggingface, cerebras, mistral, cohere, ollama)
# AI_PROVIDER="groq"
